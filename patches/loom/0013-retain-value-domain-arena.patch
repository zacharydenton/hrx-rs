+TEST_F(SymbolicExprTest, LocalDomainOutlivesTemporaryQueryArena) {
+  loom_local_value_domain_t domain = {};
+  IREE_ASSERT_OK(loom_local_value_domain_acquire_for_region(
+      module_, module_->body, &analysis_arena_, &domain));
+  iree_arena_block_pool_t query_pool = {};
+  iree_arena_block_pool_initialize(4096, iree_allocator_system(), &query_pool);
+  iree_arena_allocator_t query_arena = {};
+  iree_arena_initialize(&query_pool, &query_arena);
+  loom_symbolic_expr_context_t query = {};
+  loom_symbolic_expr_context_initialize(module_, &domain, &fact_table_,
+                                       &query_arena, &query);
+  loom_value_id_t values[300];
+  for (int i = 0; i < 300; ++i) {
+    values[i] = loom_index_constant_result(BuildIndexConstant(i));
+    loom_symbolic_expr_t expression = {};
+    IREE_EXPECT_OK(loom_symbolic_expr_from_value(&query, values[i], &expression));
+    EXPECT_TRUE(loom_symbolic_expr_is_constant(&expression));
+    EXPECT_EQ(expression.constant, i);
+  }
+  // Queries may grow the domain, but must never move its value list into
+  // their own temporary storage. Destroy that storage before domain cleanup.
+  iree_arena_deinitialize(&query_arena);
+  iree_arena_block_pool_deinitialize(&query_pool);
+  EXPECT_EQ(domain.value_count, 300u);
+  for (loom_value_ordinal_t i = 0; i < 300; ++i) {
+    EXPECT_EQ(domain.value_ids[i], values[i]);
+    EXPECT_EQ(loom_local_value_domain_try_ordinal(&domain, values[i]), i);
+  }
+  loom_local_value_domain_release(&domain);
+  EXPECT_FALSE(loom_module_value_ordinal_scratch_is_active(module_));
+}
