+@cache
+def _gfx906_core_overlays() -> tuple[AmdgpuDescriptorOverlay, ...]:
+    # These CDNA capabilities have no GCN5 instruction contract. In particular,
+    # no global/flat floating atomic addition or direct global-to-LDS path is
+    # advertised by the GCN5 target.
+    unsupported = frozenset((
+        "BUFFER_INV", "BUFFER_WBL2", "DS_ADD_F64", "DS_ADD_RTN_F64",
+        "FLAT_ATOMIC_ADD_F64", "GLOBAL_ATOMIC_ADD_F64",
+        "FLAT_ATOMIC_ADD_F32", "GLOBAL_ATOMIC_ADD_F32",
+        "GLOBAL_LOAD_LDS_DWORD", "GLOBAL_LOAD_LDS_SBYTE",
+        "GLOBAL_LOAD_LDS_SSHORT", "GLOBAL_LOAD_LDS_UBYTE", "GLOBAL_LOAD_LDS_USHORT",
+    ))
+    rows = []
+    for row in _cdna_core_overlays(isa_generation=1, matrix_overlays=()):
+        if row.instruction_name in unsupported:
+            continue
+        if row.instruction_name.startswith("V_MAD_MIX"):
+            # Vega 20 implements the fused MIX operation. The donor XML keeps
+            # the historical MAD instruction name; expose FMA source semantics
+            # and native assembly names, as independently decoded by LLVM.
+            row = replace(row,
+                descriptor_key=row.descriptor_key.replace(".v_mad_mix", ".v_fma_mix"),
+                mnemonic=row.mnemonic.replace("v_mad_mix", "v_fma_mix"),
+                semantic_tag=row.semantic_tag.replace("float.mad.mix", "float.fma.mix"))
+        rows.append(row)
+    return tuple(rows)
+
+
