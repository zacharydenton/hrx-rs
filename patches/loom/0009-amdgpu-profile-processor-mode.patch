+TEST(AmdgpuTargetTest, ProcessorModeChangesOnlySchedulingDescriptorBit) {
+  auto environment = CreateAmdgpuTargetEnvironment();
+  auto context = CreateAmdgpuContext(environment.get());
+  auto workspace = CreateWorkspace();
+  auto compiler = CreateCompiler(context.get());
+  auto pipeline = CreatePreparedLowPassProgram(context.get());
+  auto source = CreateTextSource("mode_store.loom", R"(
+amdgpu.target<gfx11-generic> @generic
+kernel.def target(@generic) @mode_store() {
+  %one = index.constant 1 : index
+  %size = index.constant 64 : index
+  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
+} launch(%output: buffer) {
+  %zero_offset = index.constant 0 : offset
+  %zero_index = index.constant 0 : index
+  %value = scalar.constant 7 : i32
+  %global = buffer.assume.memory_space<global> %output : buffer
+  %view = buffer.view %global[%zero_offset] : buffer -> view<1xi32>
+  view.store %value, %view[%zero_index] : i32, view<1xi32>
+  kernel.return
+}
+)");
+  std::vector<std::string> binaries;
+  for (auto mode :
+       {LOOMC_AMDGPU_PROCESSOR_MODE_DEFAULT, LOOMC_AMDGPU_PROCESSOR_MODE_WGP,
+        LOOMC_AMDGPU_PROCESSOR_MODE_CU}) {
+    auto profile = CreateTargetProfile(environment.get(), "gfx1151", {}, mode);
+    auto module =
+        DeserializeModule(context.get(), workspace.get(), source.get());
+    const loomc_target_specialization_t specialization = {
+        loomc_make_cstring_view("mode_store"), profile.get()};
+    loomc_target_specialization_options_t target_options = {
+        LOOMC_STRUCTURE_TYPE_TARGET_SPECIALIZATION_OPTIONS,
+        sizeof(target_options), nullptr, &specialization, 1};
+    loomc_compile_options_t options = {};
+    options.next = &target_options;
+    options.artifact_flags = LOOMC_COMPILE_ARTIFACT_FLAG_MODULE_TEXT;
+    loomc_result_t* result = nullptr;
+    LOOMC_ASSERT_OK(loomc_compile_module(compiler.get(), workspace.get(),
+                                         pipeline.get(), module.get(), &options,
+                                         loomc_allocator_system(), &result));
+    ResultPtr compiled(result);
+    ExpectSucceededResult(compiled.get());
+    profile.reset();
+    auto emitted =
+        EmitModule(environment.get(), workspace.get(), module.get(), 0);
+    ExpectSucceededResult(emitted.get());
+    const auto* artifact =
+        FindArtifact(emitted.get(), LOOMC_ARTIFACT_KIND_EXECUTABLE,
+                     LOOMC_ARTIFACT_FORMAT_AMDGPU_HSACO);
+    ASSERT_NE(artifact, nullptr);
+    binaries.push_back(ToString(artifact->contents));
+    const auto* text = FindArtifact(compiled.get(), LOOMC_ARTIFACT_KIND_MODULE,
+                                    LOOMC_ARTIFACT_FORMAT_LOOM_TEXT);
+    ASSERT_NE(text, nullptr);
+    auto serialized =
+        CreateTextSource("roundtrip.loom", ToString(text->contents).c_str());
+    auto fresh_context = CreateAmdgpuContext(environment.get());
+    auto roundtrip = DeserializeModule(fresh_context.get(), workspace.get(),
+                                       serialized.get());
+    auto reemitted =
+        EmitModule(environment.get(), workspace.get(), roundtrip.get(), 0);
+    ExpectSucceededResult(reemitted.get());
+    const auto* roundtrip_artifact =
+        FindArtifact(reemitted.get(), LOOMC_ARTIFACT_KIND_EXECUTABLE,
+                     LOOMC_ARTIFACT_FORMAT_AMDGPU_HSACO);
+    ASSERT_NE(roundtrip_artifact, nullptr);
+    EXPECT_EQ(ToString(roundtrip_artifact->contents), binaries.back());
+  }
+  ASSERT_EQ(binaries[0], binaries[1]);
+  ASSERT_EQ(binaries[0].size(), binaries[2].size());
+  size_t differences = 0;
+  for (size_t i = 0; i < binaries[0].size(); ++i) {
+    if (binaries[0][i] != binaries[2][i]) {
+      ++differences;
+      EXPECT_EQ(static_cast<unsigned char>(binaries[0][i]) ^
+                    static_cast<unsigned char>(binaries[2][i]),
+                0x20u);
+      EXPECT_NE(static_cast<unsigned char>(binaries[0][i]) & 0x20u, 0u);
+    }
+  }
+  EXPECT_EQ(differences, 1u);
+}
