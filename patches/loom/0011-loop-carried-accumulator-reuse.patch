+// in place, keeps one register tuple: the scaling writes the lanes it reads,
+// the matrix multiply accumulates in place and the back edge copies nothing,
+// although the lanes are read again after the loop.
+// ----
+  s_mov_b32 s1, 0
+  v_mov_b32 v26, v24
+.Lbb1:
+  s_cmp_lt_i32 s1, s0
+  s_delay_alu instid0(SALU_CYCLE_1)
+  s_cbranch_scc0 .Lbb3
+.Lbb2:
+  s_add_u32 s1, s1, 1
+  v_dual_mul_f32 v0, v0, v24 :: v_dual_mul_f32 v1, v1, v26
+  v_dual_mul_f32 v2, v24, v2 :: v_dual_mul_f32 v3, v3, v24
+  v_dual_mul_f32 v4, v4, v24 :: v_dual_mul_f32 v5, v5, v26
+  v_dual_mul_f32 v6, v24, v6 :: v_dual_mul_f32 v7, v7, v24
+  s_nop 3
+  v_wmma_f32_16x16x16_f16 v[0:7], v[8:15], v[16:23], v[0:7]
+  s_branch .Lbb1
+.Lbb3:
+  global_store_b32 v25, v0, s[2:3] offset:0
+  global_store_b32 v25, v1, s[2:3] offset:128
+  global_store_b32 v25, v2, s[2:3] offset:256
+  global_store_b32 v25, v3, s[2:3] offset:384
+  global_store_b32 v25, v4, s[2:3] offset:512
+  global_store_b32 v25, v5, s[2:3] offset:640
+  global_store_b32 v25, v6, s[2:3] offset:768
+  global_store_b32 v25, v7, s[2:3] offset:896
+  s_waitcnt_vscnt vscnt(0)
+  s_endpgm
