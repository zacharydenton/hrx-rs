+          relation->result_unit_offset != 0) {
+        continue;
+      }
+      if (relation->cause == LOOM_LOW_PLACEMENT_CAUSE_TIED_RESULT ||
+          relation->cause == LOOM_LOW_PLACEMENT_CAUSE_LOW_COPY ||
+          relation->cause == LOOM_LOW_PLACEMENT_CAUSE_LOW_MOVE) {
+        next = relation->result_ordinal;
+        continue;
+      }
+      if (relation->cause != LOOM_LOW_PLACEMENT_CAUSE_LOW_BRANCH &&
+          relation->cause != LOOM_LOW_PLACEMENT_CAUSE_LOW_SCF_YIELD) {
+        continue;
