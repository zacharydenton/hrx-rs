+// A register tuple has one semantic interval, and each unit's end point is its
+// latest use anywhere. A loop-carried tuple read lane by lane in the loop body
+// and again after the loop therefore keeps every unit through the body even
+// after that unit's last use there. Recording each unit's last use per segment
+// lets a unit's storage be reused after it in segments the value does not
+// leave live.
+typedef struct loom_low_allocation_unit_segment_record_t {
+  // Semantic segments of the value, indexing the table's |segments|.
+  loom_liveness_segment_range_t segments;
+  // Number of allocation units in the value.
+  uint32_t unit_count;
+  // First entry in the table's |ends|: |unit_count| rows of |segments.count|
+  // one-past-last use points, zero where a unit has no recorded use.
+  uint32_t ends_offset;
+  // Start and end of the value's semantic interval.
+  uint32_t start_point;
+  uint32_t end_point;
+  // False when a use fell outside every segment or storage outlives the value.
+  bool valid;
