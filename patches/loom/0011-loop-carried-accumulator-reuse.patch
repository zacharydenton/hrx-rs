+
+// ====
+
+// A loop back edge that forwards a tuple its producer defines whole, such as a
+// matrix accumulator, keeps the loop-carried argument whole: decomposed lanes
+// could not be placed back into the producer's register tuple, so every lane
+// would be copied on the back edge.
+// RUN: pass low-decompose-cfg-tuples,low-dce
+
+test.target<low_core> @test_target
+
+low.func.def target<test.low.core>(@test_target) @preserves_whole_tuple_back_edge(%cond: reg<test.i32>, %init: reg<test.i32 x2>, %update: reg<test.i32 x2>) -> (reg<test.i32>) asm {
+  low.br ^loop(%init: reg<test.i32 x2>)
+^loop(%state: reg<test.i32 x2>):
+  %s0 = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
+  %s1 = slice %state[1] : reg<test.i32 x2> -> reg<test.i32>
+  %sum = test.add.i32 %s0, %s1
+  low.cond_br %cond, ^latch, ^exit : reg<test.i32>
+^latch:
+  %next = copy %update : reg<test.i32 x2> -> reg<test.i32 x2>
+  low.br ^loop(%next: reg<test.i32 x2>)
+^exit:
+  return %sum
+}
