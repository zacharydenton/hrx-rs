+      arena, unit_liveness->point_count, sizeof(*table->record_by_point_start),
+      (void**)&table->record_by_point_start));
+  memset(table->record_by_point_start, 0xFF,
+         unit_liveness->point_count * sizeof(*table->record_by_point_start));
+  table->point_count = unit_liveness->point_count;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, record_count, sizeof(*table->records), (void**)&table->records));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, record_count, sizeof(*unit_liveness->unit_segment_value_ordinals),
