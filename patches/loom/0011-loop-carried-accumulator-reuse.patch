+  IREE_RETURN_IF_ERROR(
+      iree_arena_allocate_array(arena, (iree_host_size_t)end_count,
+                                sizeof(*table->ends), (void**)&table->ends));
+  memset(table->ends, 0, (iree_host_size_t)end_count * sizeof(*table->ends));
+  uint32_t record_index = 0;
+  uint32_t ends_offset = 0;
+  for (iree_host_size_t i = 0; i < liveness->value_count; ++i) {
+    const loom_liveness_interval_t* interval =
+        loom_liveness_interval_for_value_ordinal(liveness,
+                                                 (loom_value_ordinal_t)i);
+    const loom_liveness_segment_range_t range =
+        liveness->value_segment_ranges[i];
+    const uint32_t point_start =
