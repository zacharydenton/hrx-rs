+// Records a use of units of the value whose unit records start at
+// |unit_point_start| in each semantic segment containing |point|. A use at a
+// segment's end point is a block boundary use and belongs to that segment. A
+// use outside every segment invalidates the value's refinement.
+static void loom_low_allocation_unit_liveness_note_segment_use(
+    loom_low_allocation_unit_liveness_t* unit_liveness,
+    uint32_t unit_point_start, uint32_t unit_offset, uint32_t unit_count,
+    uint32_t point) {
+  loom_low_allocation_unit_segment_ends_t* table =
+      &unit_liveness->unit_segment_ends;
+  if (table->record_by_point_start == NULL ||
+      unit_point_start >= table->point_count) {
+    return;
+  }
+  const uint32_t record_index = table->record_by_point_start[unit_point_start];
+  if (record_index == UINT32_MAX) {
+    return;
+  }
+  loom_low_allocation_unit_segment_record_t* record =
+      &table->records[record_index];
+  bool found = false;
+  for (uint32_t k = 0; k < record->segments.count; ++k) {
+    const loom_liveness_segment_t* segment =
+        &table->segments[record->segments.start + k];
+    if (point < segment->start_point || point > segment->end_point) {
+      continue;
+    }
+    found = true;
+    for (uint32_t i = 0; i < unit_count; ++i) {
+      uint32_t* end =
+          &table->ends[record->ends_offset +
+                       (unit_offset + i) * record->segments.count + k];
+      *end = iree_max(*end, point + 1u);
+    }
+  }
+  if (!found) {
+    record->valid = false;
+  }
+}
