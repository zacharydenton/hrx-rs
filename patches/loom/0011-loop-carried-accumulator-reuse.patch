+    uint32_t lhs_start_point, uint32_t lhs_end_point,
+    const loom_low_allocation_assignment_t* rhs, uint32_t rhs_unit_offset,
+    uint32_t rhs_start_point, uint32_t rhs_end_point) {
+  enum { kMaxRefinedSegments = 16 };
+  loom_liveness_segment_t lhs_ranges[kMaxRefinedSegments];
+  loom_liveness_segment_t rhs_ranges[kMaxRefinedSegments];
+  uint32_t lhs_count = loom_low_allocation_live_range_refined_unit_ranges(
+      table, lhs, lhs_unit_offset, lhs_end_point, lhs_ranges,
+      kMaxRefinedSegments);
+  uint32_t rhs_count = loom_low_allocation_live_range_refined_unit_ranges(
+      table, rhs, rhs_unit_offset, rhs_end_point, rhs_ranges,
+      kMaxRefinedSegments);
+  if (lhs_count == 0 && rhs_count == 0) {
+    return false;
+  }
+  if (lhs_count == 0) {
+    lhs_ranges[0] = (loom_liveness_segment_t){lhs_start_point, lhs_end_point};
+    lhs_count = 1;
+  }
+  if (rhs_count == 0) {
+    rhs_ranges[0] = (loom_liveness_segment_t){rhs_start_point, rhs_end_point};
+    rhs_count = 1;
+  }
+  for (uint32_t i = 0; i < lhs_count; ++i) {
+    const uint32_t lhs_begin =
+        iree_max(lhs_ranges[i].start_point, lhs_start_point);
+    const uint32_t lhs_end = iree_min(lhs_ranges[i].end_point, lhs_end_point);
+    for (uint32_t j = 0; j < rhs_count; ++j) {
+      const uint32_t rhs_begin =
+          iree_max(rhs_ranges[j].start_point, rhs_start_point);
+      const uint32_t rhs_end = iree_min(rhs_ranges[j].end_point, rhs_end_point);
+      if (lhs_begin < rhs_end && rhs_begin < lhs_end && lhs_begin < lhs_end &&
+          rhs_begin < rhs_end) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
