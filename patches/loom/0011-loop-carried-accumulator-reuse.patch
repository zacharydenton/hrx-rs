+static iree_status_t loom_low_allocation_unit_liveness_initialize_segment_ends(
+    const loom_liveness_analysis_t* liveness, iree_arena_allocator_t* arena,
+    loom_low_allocation_unit_liveness_t* unit_liveness) {
+  loom_low_allocation_unit_segment_ends_t* table =
+      &unit_liveness->unit_segment_ends;
+  if (liveness->value_segment_ranges == NULL ||
+      unit_liveness->point_starts_by_value_ordinal == NULL) {
+    return iree_ok_status();
+  }
+  table->segments = liveness->segments;
+  uint32_t record_count = 0;
+  uint64_t end_count = 0;
+  for (iree_host_size_t i = 0; i < liveness->value_count; ++i) {
+    const loom_liveness_interval_t* interval =
+        loom_liveness_interval_for_value_ordinal(liveness,
+                                                 (loom_value_ordinal_t)i);
+    const loom_liveness_segment_range_t range =
+        liveness->value_segment_ranges[i];
+    if (unit_liveness->point_starts_by_value_ordinal[i] == UINT32_MAX ||
+        interval->unit_count < 2 || range.count < 2) {
+      continue;
