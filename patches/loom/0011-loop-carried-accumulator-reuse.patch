+        loom_low_placement_relation_range_for_source_value_ordinal(placement,
+                                                                   ordinal);
+    loom_value_ordinal_t next = LOOM_VALUE_ORDINAL_INVALID;
+    for (uint32_t i = 0; i < range.count; ++i) {
+      const loom_low_placement_relation_t* relation =
+          &placement->relations
