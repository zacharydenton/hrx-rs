+// Writes the live ranges of |unit_offset| of |assignment| refined by its
+// per-segment last uses. Returns 0 when the assignment has no valid record, in
+// which case callers keep its linear per-unit lifetime.
+static uint32_t loom_low_allocation_live_range_refined_unit_ranges(
+    const loom_low_allocation_unit_segment_ends_t* table,
+    const loom_low_allocation_assignment_t* assignment, uint32_t unit_offset,
+    uint32_t unit_end_point, loom_liveness_segment_t* out_ranges,
+    uint32_t capacity) {
+  if (table == NULL || table->record_by_point_start == NULL ||
+      assignment->unit_point_start >= table->point_count) {
+    return 0;
+  }
+  const uint32_t record_index =
+      table->record_by_point_start[assignment->unit_point_start];
+  if (record_index == UINT32_MAX) {
+    return 0;
+  }
+  const loom_low_allocation_unit_segment_record_t* record =
+      &table->records[record_index];
+  // Only the value's own storage is described: a reservation that starts
+  // earlier or ends later than the semantic interval keeps linear lifetimes.
+  if (!record->valid || record->segments.count > capacity ||
+      unit_offset >= record->unit_count ||
+      assignment->location_count != record->unit_count ||
+      assignment->start_point < record->start_point ||
+      assignment->end_point > record->end_point) {
+    return 0;
+  }
+  const uint32_t* ends =
+      &table->ends[record->ends_offset + unit_offset * record->segments.count];
+  uint32_t count = 0;
+  for (uint32_t k = 0; k < record->segments.count; ++k) {
+    const loom_liveness_segment_t* segment =
+        &table->segments[record->segments.start + k];
+    // A unit without a recorded use in a segment keeps the whole segment. A
+    // unit end point inside the segment covers lifetime extended after the
+    // recorded uses.
+    uint32_t end_point = ends[k] == 0 ? segment->end_point : ends[k];
+    if (unit_end_point > segment->start_point &&
+        unit_end_point <= segment->end_point + 1u &&
+        unit_end_point > end_point) {
+      end_point = unit_end_point;
+    }
+    if (k + 1 == record->segments.count && unit_end_point > end_point &&
+        unit_end_point > segment->end_point) {
+      end_point = unit_end_point;
+    }
+    out_ranges[count++] = (loom_liveness_segment_t){
+        .start_point = segment->start_point,
+        .end_point = iree_max(end_point, segment->start_point + 1u),
+    };
+  }
+  return count;
+}
+
+bool loom_low_allocation_unit_segment_ends_unit_live_at_point(
+    const loom_low_allocation_unit_segment_ends_t* table,
+    uint32_t unit_point_start, uint32_t unit_offset, uint32_t unit_end_point,
+    uint32_t point, bool* out_live) {
+  *out_live = true;
+  if (table == NULL || table->record_by_point_start == NULL ||
+      unit_point_start >= table->point_count) {
+    return false;
+  }
+  const uint32_t record_index = table->record_by_point_start[unit_point_start];
+  if (record_index == UINT32_MAX) {
+    return false;
+  }
+  const loom_low_allocation_unit_segment_record_t* record =
+      &table->records[record_index];
+  const loom_low_allocation_assignment_t whole = {
+      .unit_point_start = unit_point_start,
+      .location_count = record->unit_count,
+      .start_point = record->start_point,
+      .end_point = record->end_point,
+  };
+  enum { kMaxRefinedSegments = 16 };
+  loom_liveness_segment_t ranges[kMaxRefinedSegments];
+  const uint32_t count = loom_low_allocation_live_range_refined_unit_ranges(
+      table, &whole, unit_offset, unit_end_point, ranges, kMaxRefinedSegments);
+  if (count == 0) {
+    return false;
+  }
+  bool live = false;
+  for (uint32_t i = 0; i < count; ++i) {
+    live |= point >= ranges[i].start_point && point < ranges[i].end_point;
+  }
+  *out_live = live;
+  return true;
+}
