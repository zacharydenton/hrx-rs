--- /dev/null
+++ b/loom/src/loom/target/arch/amdgpu/test/source_low/source_low_feedback_polling.loom-test
@@ -0,0 +1,59 @@
+// RUN: with-checks emit source-low output=low
+amdgpu.target<gfx1151> @target {subgroup_size = 32}
+kernel.def target(@target) @polled_feedback() {
+  %one = index.constant 1 : index
+  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
+} launch(%condition: i1) {
+  kernel.assert %condition : i1
+  kernel.return
+}
+// ----
+// Capacity and reservation masks must be intersected with active EXEC before
+// a 64-bit scalar test; wave32 comparisons only define the lower mask word.
+CHECK: * = v_cmp_le_u32 *
+CHECK: * = s_mov_b64_exec_read
+CHECK: * = s_and_b64 *
+CHECK: * = s_cmp_lg_u64 *
+CHECK: low.cond_br *
+CHECK: * = global_atomic_cmpswap_b64*
+CHECK: * = s_and_b64 *
+CHECK: * = s_and_b64 *
+CHECK: * = s_cmp_lg_u64 *
+CHECK: low.cond_br *
+// Publish the packet first, then branch around notification when signal is null.
+CHECK: global_store_b32_saddr * {offset = 12}
+CHECK: * = s_cmp_lg_u64 *
+CHECK: low.cond_br *
+CHECK: * = global_load_b64_saddr * {offset = 16, glc = 1}
+CHECK: s_sendmsg * {message = 1}
+
+// ====
+
+// RUN: with-checks emit source-low output=low
+amdgpu.target<gfx1151> @target {subgroup_size = 64}
+kernel.def target(@target) @polled_feedback() {
+  %one = index.constant 1 : index
+  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
+} launch(%condition: i1) {
+  kernel.assert %condition : i1
+  kernel.return
+}
+// ----
+// Capacity and reservation masks must be intersected with active EXEC before
+// a 64-bit scalar test; wave32 comparisons only define the lower mask word.
+CHECK: * = v_cmp_le_u32 *
+CHECK: * = s_mov_b64_exec_read
+CHECK: * = s_and_b64 *
+CHECK: * = s_cmp_lg_u64 *
+CHECK: low.cond_br *
+CHECK: * = global_atomic_cmpswap_b64*
+CHECK: * = s_and_b64 *
+CHECK: * = s_and_b64 *
+CHECK: * = s_cmp_lg_u64 *
+CHECK: low.cond_br *
+// Publish the packet first, then branch around notification when signal is null.
+CHECK: global_store_b32_saddr * {offset = 12}
+CHECK: * = s_cmp_lg_u64 *
+CHECK: low.cond_br *
+CHECK: * = global_load_b64_saddr * {offset = 16, glc = 1}
+CHECK: s_sendmsg * {message = 1}
