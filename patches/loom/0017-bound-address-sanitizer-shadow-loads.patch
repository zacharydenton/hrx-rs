+++ b/loom/src/loom/target/arch/amdgpu/test/source_low/source_low_sanitizer_address_bounds.loom-test
@@ -0,0 +1,47 @@
+// RUN: with-checks emit source-low output=low sanitizer=access sanitizer-reporting=trap
+amdgpu.target<gfx11-generic> @target {subgroup_size = 32}
+func.def target(@target) @bounded_access_32(%input: buffer) {
+  %zero = index.constant 0 : offset
+  %global = buffer.assume.memory_space<global> %input : buffer
+  %aligned = buffer.assume.alignment %global {minimum_alignment = 8} : buffer
+  %view = buffer.view %aligned[%zero] : buffer -> view<1xi8>
+  sanitizer.assert.access<read> %view[0] {static_extents = [1]} : view<1xi8>
+  func.return
+}
+// ----
+// Bounds are loaded before the application and physical shadow comparisons.
+// Only included lanes issue the load, then the original EXEC is restored.
+CHECK: *{offset = 24*}
+CHECK: *{offset = 32*}
+CHECK: *{offset = 40*}
+CHECK: * = v_cmp_gt_u32 *
+CHECK: * = v_cmp_lt_u32 *
+CHECK: * = s_and_saveexec_b64 *
+CHECK: * = flat_load_u8 *
+CHECK: s_mov_b64_exec *
+CHECK: * = v_cndmask_b32 *
+
+// ====
+
+// RUN: with-checks emit source-low output=low sanitizer=access sanitizer-reporting=trap
+amdgpu.target<gfx11-generic> @target {subgroup_size = 64}
+func.def target(@target) @bounded_access_64(%input: buffer) {
+  %zero = index.constant 0 : offset
+  %global = buffer.assume.memory_space<global> %input : buffer
+  %aligned = buffer.assume.alignment %global {minimum_alignment = 8} : buffer
+  %view = buffer.view %aligned[%zero] : buffer -> view<64xi8>
+  sanitizer.assert.access<read> %view[0] {static_extents = [64]} : view<64xi8>
+  func.return
+}
+// ----
+// Bounds are loaded before the application and physical shadow comparisons.
+// Only included lanes issue the load, then the original EXEC is restored.
+CHECK: *{offset = 24*}
+CHECK: *{offset = 32*}
+CHECK: *{offset = 40*}
+CHECK: * = v_cmp_gt_u32 *
+CHECK: * = v_cmp_lt_u32 *
+CHECK: * = s_and_saveexec_b64 *
+CHECK: * = flat_load_dwordx2 *
+CHECK: s_mov_b64_exec *
+CHECK: * = v_cndmask_b32 *
