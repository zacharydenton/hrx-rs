+static iree_status_t loom_amdgpu_sanitizer_access_compare_u64(
+    loom_builder_t* builder, const loom_low_descriptor_set_t* descriptor_set,
+    loom_value_id_t lhs, loom_value_id_t rhs, bool less,
+    loom_location_id_t location, loom_value_id_t* out_mask) {
+  loom_value_id_t vgpr_lhs, vgpr_rhs;
+  IREE_RETURN_IF_ERROR(loom_amdgpu_build_feedback_vgpr_registers(
+      builder, descriptor_set, lhs, 2, location, &vgpr_lhs));
+  IREE_RETURN_IF_ERROR(loom_amdgpu_build_feedback_vgpr_registers(
+      builder, descriptor_set, rhs, 2, location, &vgpr_rhs));
+  loom_type_t vgpr_type = loom_type_none();
+  IREE_RETURN_IF_ERROR(loom_low_build_register_type(
+      descriptor_set, LOOM_AMDGPU_REG_CLASS_ID_VGPR, 1, &vgpr_type));
+  loom_value_id_t l[2], r[2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    IREE_RETURN_IF_ERROR(loom_amdgpu_sanitizer_access_build_register_lane(
+        builder, vgpr_lhs, i, vgpr_type, location, &l[i]));
+    IREE_RETURN_IF_ERROR(loom_amdgpu_sanitizer_access_build_register_lane(
+        builder, vgpr_rhs, i, vgpr_type, location, &r[i]));
+  }
+  loom_value_id_t high, equal, low, same_high;
+  IREE_RETURN_IF_ERROR(loom_amdgpu_sanitizer_access_mask_binary(
+      builder, descriptor_set,
+      less ? LOOM_AMDGPU_DESCRIPTOR_REF_V_CMP_ULT_U32
+           : LOOM_AMDGPU_DESCRIPTOR_REF_V_CMP_UGT_U32,
+      l[1], r[1], location, &high));
+  IREE_RETURN_IF_ERROR(loom_amdgpu_sanitizer_access_mask_binary(
+      builder, descriptor_set, LOOM_AMDGPU_DESCRIPTOR_REF_V_CMP_EQ_I32, l[1],
+      r[1], location, &equal));
+  IREE_RETURN_IF_ERROR(loom_amdgpu_sanitizer_access_mask_binary(
+      builder, descriptor_set,
+      less ? LOOM_AMDGPU_DESCRIPTOR_REF_V_CMP_ULT_U32
+           : LOOM_AMDGPU_DESCRIPTOR_REF_V_CMP_UGE_U32,
+      l[0], r[0], location, &low));
+  IREE_RETURN_IF_ERROR(loom_amdgpu_sanitizer_access_mask_binary(
+      builder, descriptor_set, LOOM_AMDGPU_DESCRIPTOR_REF_S_AND_B64, equal, low,
+      location, &same_high));
+  return loom_amdgpu_sanitizer_access_mask_binary(
+      builder, descriptor_set, LOOM_AMDGPU_DESCRIPTOR_REF_S_OR_B64, high,
+      same_high, location, out_mask);
+}
