+static iree_status_t loom_amdgpu_sanitizer_access_mask_binary(
+    loom_builder_t* builder, const loom_low_descriptor_set_t* descriptor_set,
+    loom_amdgpu_descriptor_ref_t ref, loom_value_id_t lhs, loom_value_id_t rhs,
