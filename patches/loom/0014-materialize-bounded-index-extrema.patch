diff --git a/loom/py/loom/target/arch/amdgpu/contracts/arithmetic_test.py b/loom/py/loom/target/arch/amdgpu/contracts/arithmetic_test.py
--- a/loom/py/loom/target/arch/amdgpu/contracts/arithmetic_test.py
+++ b/loom/py/loom/target/arch/amdgpu/contracts/arithmetic_test.py
@@ -816,3 +816,26 @@
                 if guard.kind == GuardKind.VALUE_PACKED_INTEGER_LANES_FROM_PAYLOAD
             )
         assert sorted(maximum_lane_counts) == [32, 64]
+
+
+def test_index_extrema_materialize_proven_narrow_operands() -> None:
+    compiled = _compiled_integer_rules()
+    for source_op in (index.index_min, index.index_max):
+        rules = _rules_for_source_op(compiled, source_op)
+        assert len(rules) == 2  # Scalar and varying operands.
+        for rule in rules:
+            emit = compiled.emits[rule.emit_start]
+            operands = compiled.value_refs[
+                emit.operand_ref_start : emit.operand_ref_start + emit.operand_ref_count
+            ]
+            assert len(operands) == 2
+            assert all(operand.materializer_index != 0 for operand in operands)
+            guards = compiled.guards[rule.guard_start : rule.guard_start + rule.guard_count]
+            signed_inputs = {
+                compiled.value_refs[guard.value_ref_index].index
+                for guard in guards
+                if guard.kind == GuardKind.VALUE_SIGNED_BIT_COUNT
+                and guard.u64 == 32
+                and compiled.value_refs[guard.value_ref_index].kind == SourceValueKind.OPERAND
+            }
+            assert signed_inputs == {0, 1}
