diff --git a/loom/py/loom/target/arch/amdgpu/descriptors/timing_test.py b/loom/py/loom/target/arch/amdgpu/descriptors/timing_test.py
index 06dfe912a7..9bc30528d5 100644
--- a/loom/py/loom/target/arch/amdgpu/descriptors/timing_test.py
+++ b/loom/py/loom/target/arch/amdgpu/descriptors/timing_test.py
@@ -166,3 +166,25 @@ def test_other_producers_preserve_their_result_timing() -> None:
     # The selected producer fixes the class of a mixed SGPR/VGPR source.
     assert vector_move.operands[1].read_event == "amdgpu.sgpr.read"
     assert scalar_load.operands[1].read_event == "amdgpu.sgpr.read"
+
+
+def test_lds_overlap_preserves_required_classes_and_completion_hazards() -> None:
+    descriptors = tuple(
+        _amdgpu_contract_descriptor_from_overlay(overlay)
+        for overlay in (
+            _ds_read_overlay(width_bits=128, units=4),
+            _ds_write_overlay(width_bits=32, units=1),
+        )
+    )
+    original = replace(_AMDGPU_RDNA3_CORE_DESCRIPTOR_SET_BASE, descriptors=descriptors)
+    timed = _with_lds_service_timing(original, 32)
+    overlap = _with_lds_service_timing(original, 32, reserve_bandwidth=False)
+    assert overlap.descriptors == timed.descriptors
+    assert {row.name for row in overlap.schedule_classes} == {
+        row.name for row in timed.schedule_classes
+    }
+    parents = {row.name: row for row in original.schedule_classes}
+    variants = {row.name: row for row in overlap.schedule_classes}
+    for before, after in zip(descriptors, overlap.descriptors, strict=True):
+        parent = parents[before.schedule_class]
+        assert replace(variants[after.schedule_class], name=parent.name) == parent
