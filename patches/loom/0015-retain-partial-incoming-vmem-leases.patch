+// RUN: with-checks emit amdgpu-assembly @partial_incoming_reuse strategy=source fixed=%old:physical_register:4:4 fixed=%younger:physical_register:4:1 fixed=%replacement:physical_register:7:1
+
+// The narrow VMEM write orders reuse of v4 only. It must not retire the
+// incoming wide result's remaining v5-v7 units before the ALU overwrites v7.
+amdgpu.target<gfx1151> @target
+
+low.func.def target<amdgpu.rdna3_5.core>(@target) @partial_incoming_reuse(%address: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr>) asm {
+  %old = global_load_b128_saddr %address, %base
+  low.br ^overwrite
+^overwrite:
+  %younger = global_load_b32_saddr %address, %base {offset = 16}
+  %replacement = v_mov_b32 42
+  %result = v_add_u32 %replacement, %younger
+  return %result
+}
+
+// ----
+CHECK: global_load_b128 v[4:7]*
+CHECK: global_load_b32 v4*
+CHECK: s_waitcnt vmcnt(1)*
+CHECK: v_mov_b32 v7, 42
+CHECK: s_waitcnt vmcnt(0)*
