+// ====
+// RUN: emit amdgpu-assembly @global_load_address_reuse_gfx1151 strategy=source fixed=%base:physical_register:0:2 fixed=%output:physical_register:2:2 fixed=%replacement:physical_register:0:1
+
+amdgpu.target<gfx1151> @target
+
+low.func.def target<amdgpu.rdna3_5.core>(@target) @global_load_address_reuse_gfx1151(%addr: reg<amdgpu.vgpr>, %base: reg<amdgpu.sgpr x2>, %output: reg<amdgpu.sgpr x2>) asm {
+  %loaded = global_load_b32_saddr %addr, %base
+  %replacement = s_mov_b32 0
+  global_store_b32_saddr %addr, %loaded, %output
+  return
+}
+
+// SGPR address consumption is interlocked on GFX11. Replacing the address
+// low half does not wait for memory completion; consuming the loaded VGPR does.
+// ----
+  global_load_b32 v1, v0, s[0:1] offset:0
+  s_mov_b32 s0, 0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  global_store_b32 v0, v1, s[2:3] offset:0
+  s_waitcnt_vscnt vscnt(0)
+  s_endpgm
