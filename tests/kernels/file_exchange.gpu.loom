// One invocation owns an initially empty Linux SQ/CQ with one in-flight I/O.
// The host establishes fixed file/buffer tables and SQPOLL progress, but never
// publishes SQEs or consumes CQEs while it runs. READ_FIXED and WRITE_FIXED use
// CPU virtual addresses; shader accesses use separately established GPU VAs.
//
// Each round reads a cause-selected immutable block, transforms every word,
// writes another file block, and reloads it into a distinct payload window.
// The actual reload's first word determines the next request. Positive partial
// completions advance file and buffer offsets; EOF and negative results stop
// issuance only after the sole outstanding request has completed.
//
// Payload windows are separated by payload_stride bytes. Records contain four
// summary words, then round_count records of three header words and word_count
// payload words. The caller retains every owner through native retirement.
kernel.def export("file_exchange") @file_exchange() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%submission_entries: buffer, %submission_tail: buffer, %completion_entries: buffer, %completion_head: buffer, %completion_tail: buffer, %payload: buffer, %records: buffer, %host_payload: i64, %submission_mask: i32, %completion_mask: i32, %round_count: i32, %word_count: i32, %file_block_mask: i32, %seed: i32, %payload_stride: i32, %file_index: i32) {
  %sqes = buffer.assume.alignment %submission_entries {minimum_alignment = 64} : buffer
  %sq_tail = buffer.assume.alignment %submission_tail {minimum_alignment = 4} : buffer
  %cqes = buffer.assume.alignment %completion_entries {minimum_alignment = 8} : buffer
  %cq_head = buffer.assume.alignment %completion_head {minimum_alignment = 4} : buffer
  %cq_tail = buffer.assume.alignment %completion_tail {minimum_alignment = 4} : buffer
  %windows = buffer.assume.alignment %payload {minimum_alignment = 4} : buffer
  %transcript = buffer.assume.alignment %records {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %word_bytes = index.constant 4 : offset
  %sqe_bytes = index.constant 64 : offset
  %cqe_bytes = index.constant 16 : offset
  %summary_bytes = index.constant 16 : offset
  %header_words = index.constant 3 : index
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %four = scalar.constant 4 : i32
  %five = scalar.constant 5 : i32
  %read_flags = scalar.constant 260 : i32
  %write_flags = scalar.constant 261 : i32
  %incomplete = scalar.constant -61 : i32
  %count_input = index.cast %word_count : i32 to index
  %count = index.assume %count_input [range(%count_input, 1, 16384)] : index
  %blocks = scalar.addi %file_block_mask, %one : i32
  %record_words = index.add %count, %header_words : index
  %record_bytes = index.scale %record_words, %word_bytes : index, offset -> offset
  %length = scalar.muli %word_count, %four : i32
  %length_wide = scalar.extui %length : i32 to i64
  %stride = index.cast %payload_stride : i32 to offset
  %reload_stride = index.add %stride, %stride : offset
  %input = buffer.view %windows[%origin] : buffer -> view<[%count]xi32>
  %output = buffer.view %windows[%stride] : buffer -> view<[%count]xi32>
  %reload = buffer.view %windows[%reload_stride] : buffer -> view<[%count]xi32>
  %submission = buffer.view %sq_tail[%origin] : buffer -> view<1xi32>
  %completion = buffer.view %cq_tail[%origin] : buffer -> view<1xi32>
  %consumption = buffer.view %cq_head[%origin] : buffer -> view<1xi32>

  %finished, %phase_end, %progress_end, %request_count, %final_cause, %terminal = scf.while(%round = %zero : i32, %phase = %zero : i32, %progress = %zero : i32, %ticket = %zero : i32, %cause = %seed : i32, %status = %zero : i32) -> (i32, i32, i32, i32, i32, i32) {
    %more = scalar.cmpi ult, %round, %round_count : i32
    %healthy = scalar.cmpi eq, %status, %zero : i32
    %running = scalar.andi %more, %healthy : i1
    scf.condition %running, %round, %phase, %progress, %ticket, %cause, %status : i1, i32, i32, i32, i32, i32, i32
  } do(%round: i32, %phase: i32, %progress: i32, %ticket: i32, %cause: i32, %status: i32) {
    %input_block = scalar.andi %cause, %file_block_mask : i32
    %permuted = scalar.muli %input_block, %five : i32
    %shifted = scalar.addi %permuted, %one : i32
    %output_ordinal = scalar.andi %shifted, %file_block_mask : i32
    %output_block = scalar.addi %output_ordinal, %blocks : i32
    %reading_input = scalar.cmpi eq, %phase, %zero : i32
    %writing = scalar.cmpi eq, %phase, %one : i32
    %reloading = scalar.cmpi eq, %phase, %two : i32
    %block = scf.select %reading_input, %input_block, %output_block : i32
    %block_wide = scalar.extui %block : i32 to i64
    %base_offset = scalar.muli %block_wide, %length_wide : i64
    %progress_wide = scalar.extui %progress : i32 to i64
    %file_offset = scalar.addi %base_offset, %progress_wide : i64
    %window_offset = scalar.muli %phase, %payload_stride : i32
    %window_wide = scalar.extui %window_offset : i32 to i64
    %window_address = scalar.addi %host_payload, %window_wide : i64
    %io_address = scalar.addi %window_address, %progress_wide : i64
    %remaining = scalar.subi %length, %progress : i32
    %operation = scf.select %writing, %write_flags, %read_flags : i32

    %sq_position = scalar.andi %ticket, %submission_mask : i32
    %sq_index = index.cast %sq_position : i32 to index
    %sq_offset = index.scale %sq_index, %sqe_bytes : index, offset -> offset
    %sq_words = buffer.view %sqes[%sq_offset] : buffer -> view<16xi32>
    %sq_longwords = buffer.view %sqes[%sq_offset] : buffer -> view<8xi64>
    %ticket_wide = scalar.extui %ticket : i32 to i64
    // Reserved fields, rw_flags and fixed-buffer index remain initialized zero.
    view.store %operation, %sq_words[0] : i32, view<16xi32>
    view.store %file_index, %sq_words[1] : i32, view<16xi32>
    view.store %file_offset, %sq_longwords[1] : i64, view<8xi64>
    view.store %io_address, %sq_longwords[2] : i64, view<8xi64>
    view.store %remaining, %sq_words[6] : i32, view<16xi32>
    view.store %ticket_wide, %sq_longwords[4] : i64, view<8xi64>
    %next_ticket = scalar.addi %ticket, %one : i32
    // One completed request releases its SQ slot before any later reuse.
    view.atomic.store %next_ticket, %submission[0] {ordering = release, scope = system} : i32, view<1xi32>
    %observed_tail = scf.while(%tail = %ticket : i32) -> (i32) {
      %pending = scalar.cmpi eq, %tail, %ticket : i32
      scf.condition %pending, %tail : i1, i32
    } do(%tail: i32) {
      %observed = view.atomic.load %completion[0] {ordering = relaxed, scope = system} : view<1xi32> -> i32
      scf.yield %observed : i32
    }
    buffer.fence scope(system) ordering(acquire)
    %cq_position = scalar.andi %ticket, %completion_mask : i32
    %cq_index = index.cast %cq_position : i32 to index
    %cq_offset = index.scale %cq_index, %cqe_bytes : index, offset -> offset
    %cq_words = buffer.view %cqes[%cq_offset] : buffer -> view<4xi32>
    %result = view.load %cq_words[2] : view<4xi32> -> i32
    view.atomic.store %next_ticket, %consumption[0] {ordering = release, scope = system} : i32, view<1xi32>

    %positive = scalar.cmpi sgt, %result, %zero : i32
    %eof = scalar.cmpi eq, %result, %zero : i32
    %error = scf.select %eof, %incomplete, %result : i32
    %next_status = scf.select %positive, %zero, %error : i32
    %advanced = scalar.addi %progress, %result : i32
    %complete_length = scalar.cmpi eq, %advanced, %length : i32
    %complete = scalar.andi %positive, %complete_length : i1
    %next_round, %next_phase, %next_progress, %next_cause = scf.if %complete -> (i32, i32, i32, i32) {
      scf.if %reading_input {
        scf.for %element = [%first to %count step %step] {
          %value = view.load %input[%element] : view<[%count]xi32> -> i32
          %product = scalar.muli %value, %three : i32
          %biased = scalar.addi %product, %cause : i32
          %transformed = scalar.addi %biased, %round : i32
          view.store %transformed, %output[%element] : i32, view<[%count]xi32>
        }
      }
      %completed_cause = scf.if %reloading -> (i32) {
        %round_index = index.cast %round : i32 to index
        %round_offset = index.scale %round_index, %record_bytes : index, offset -> offset
        %record_offset = index.add %summary_bytes, %round_offset : offset
        %record = buffer.view %transcript[%record_offset] : buffer -> view<[%record_words]xi32>
        view.store %input_block, %record[0] : i32, view<[%record_words]xi32>
        view.store %cause, %record[1] : i32, view<[%record_words]xi32>
        view.store %output_block, %record[2] : i32, view<[%record_words]xi32>
        scf.for %element = [%first to %count step %step] {
          %value = view.load %reload[%element] : view<[%count]xi32> -> i32
          %record_element = index.add %header_words, %element : index
          view.store %value, %record[%record_element] : i32, view<[%record_words]xi32>
        }
        %actual = view.load %reload[0] : view<[%count]xi32> -> i32
        scf.yield %actual : i32
      } else {
        scf.yield %cause : i32
      }
      %advanced_round = scalar.addi %round, %one : i32
      %completed_round = scf.select %reloading, %advanced_round, %round : i32
      %advanced_phase = scalar.addi %phase, %one : i32
      %completed_phase = scf.select %reloading, %zero, %advanced_phase : i32
      scf.yield %completed_round, %completed_phase, %zero, %completed_cause : i32, i32, i32, i32
    } else {
      scf.yield %round, %phase, %advanced, %cause : i32, i32, i32, i32
    }
    scf.yield %next_round, %next_phase, %next_progress, %next_ticket, %next_cause, %next_status : i32, i32, i32, i32, i32, i32
  }
  %summary = buffer.view %transcript[%origin] : buffer -> view<4xi32>
  view.store %finished, %summary[0] : i32, view<4xi32>
  view.store %terminal, %summary[1] : i32, view<4xi32>
  view.store %request_count, %summary[2] : i32, view<4xi32>
  view.store %final_cause, %summary[3] : i32, view<4xi32>
  kernel.return
}
