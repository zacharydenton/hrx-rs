// Adapted from the pinned hrx-system XDNA image corpus for a batch of matrices.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

config.decl @gemm.batch : %value: index where [range(%value, 1, 16384)]

// Two rotating slots connect a DMA service strand to one compute strand.
pipeline.def<kernel> public retain target(@array_target) @gemm() run(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %slots = index.constant 2 : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %records = config.get @gemm.batch : index
  %lhs_aligned = buffer.assume.alignment %lhs {minimum_alignment = 64} : buffer
  %lhs_storage_bytes = index.constant 256 : offset
  %lhs_record_bytes = index.constant 128 : index
  %lhs_storage = buffer.alloca<workgroup> pool(%memory) align(64) %lhs_storage_bytes : buffer
  %lhs_slots = buffer.view %lhs_storage[%origin] : buffer -> view<2x64xbf16>
  %lhs_channel = channel.bind<fifo> %lhs_slots, %slots : view<2x64xbf16>, index -> channel<tile<64xbf16>>
  %rhs_aligned = buffer.assume.alignment %rhs {minimum_alignment = 64} : buffer
  %rhs_storage_bytes = index.constant 256 : offset
  %rhs_record_bytes = index.constant 128 : index
  %rhs_storage = buffer.alloca<workgroup> pool(%memory) align(64) %rhs_storage_bytes : buffer
  %rhs_slots = buffer.view %rhs_storage[%origin] : buffer -> view<2x64xbf16>
  %rhs_channel = channel.bind<fifo> %rhs_slots, %slots : view<2x64xbf16>, index -> channel<tile<64xbf16>>
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %output_storage_bytes = index.constant 512 : offset
  %output_record_bytes = index.constant 256 : index
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_storage_bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<2x8x8xf32>
  %output_channel = channel.bind<fifo> %output_slots, %slots : view<2x8x8xf32>, index -> channel<tile<8x8xf32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %records step %step] {
      %lhs_byte_index = index.mul %record, %lhs_record_bytes : index
      %lhs_offset = index.cast %lhs_byte_index : index to offset
      %lhs_external = buffer.view %lhs_aligned[%lhs_offset] : buffer -> view<64xbf16>
      %lhs_write, %lhs_local = channel.reserve %lhs_channel : channel<tile<64xbf16>> -> (write<tile<64xbf16>>, view<64xbf16>)
      %lhs_transfer = kernel.async.copy %lhs_external to %lhs_local {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<64xbf16> to view<64xbf16> -> kernel.async.token
      %lhs_transfer_group = kernel.async.group %lhs_transfer : kernel.async.token -> kernel.async.group
      kernel.async.wait %lhs_transfer_group {newer_groups = 0} : kernel.async.group
      channel.publish %lhs_write : write<tile<64xbf16>>
      %rhs_byte_index = index.mul %record, %rhs_record_bytes : index
      %rhs_offset = index.cast %rhs_byte_index : index to offset
      %rhs_external = buffer.view %rhs_aligned[%rhs_offset] : buffer -> view<64xbf16>
      %rhs_write, %rhs_local = channel.reserve %rhs_channel : channel<tile<64xbf16>> -> (write<tile<64xbf16>>, view<64xbf16>)
      %rhs_transfer = kernel.async.copy %rhs_external to %rhs_local {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<64xbf16> to view<64xbf16> -> kernel.async.token
      %rhs_transfer_group = kernel.async.group %rhs_transfer : kernel.async.token -> kernel.async.group
      kernel.async.wait %rhs_transfer_group {newer_groups = 0} : kernel.async.group
      channel.publish %rhs_write : write<tile<64xbf16>>
      %output_byte_index = index.mul %record, %output_record_bytes : index
      %output_offset = index.cast %output_byte_index : index to offset
      %output_external = buffer.view %output_aligned[%output_offset] : buffer -> view<8x8xf32>
      %output_read, %output_local = channel.acquire %output_channel : channel<tile<8x8xf32>> -> (read<tile<8x8xf32>>, view<8x8xf32>)
      %output_transfer = kernel.async.copy %output_local to %output_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8x8xf32> to view<8x8xf32> -> kernel.async.token
      %output_transfer_group = kernel.async.group %output_transfer : kernel.async.token -> kernel.async.group
      kernel.async.wait %output_transfer_group {newer_groups = 0} : kernel.async.group
      channel.release %output_read : read<tile<8x8xf32>>
    }
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %records step %step] {
      %lhs_read, %lhs_view = channel.acquire %lhs_channel : channel<tile<64xbf16>> -> (read<tile<64xbf16>>, view<64xbf16>)
      %rhs_read, %rhs_view = channel.acquire %rhs_channel : channel<tile<64xbf16>> -> (read<tile<64xbf16>>, view<64xbf16>)
      %output_write, %output_view = channel.reserve %output_channel : channel<tile<8x8xf32>> -> (write<tile<8x8xf32>>, view<8x8xf32>)
      %m = index.constant 8 : index
      %n = index.constant 8 : index
      %k = index.constant 8 : index
      %lhs_value = vector.load %lhs_view[0] : view<64xbf16> -> vector<64xbf16>
      %rhs_value = vector.load %rhs_view[0] : view<64xbf16> -> vector<64xbf16>
      %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
      %lhs_encoded = vector.encode %lhs_value using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
      %rhs_encoded = vector.encode %rhs_value using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
      %lhs_fragment = vector.fragment<lhs> %lhs_encoded shape [%m, %k] using {schema = %schema : encoding<schema>} : vector<72xi8>
      %rhs_fragment = vector.fragment<rhs> %rhs_encoded shape [%k, %n] using {schema = %schema : encoding<schema>} : vector<72xi8>
      %accumulator_init = vector.constant 0.0 : vector<64xf32>
      %accumulator_fragment = vector.fragment<init> %accumulator_init shape [%m, %n] : vector<64xf32>
      %product = vector.mma %lhs_fragment, %rhs_fragment, %accumulator_fragment : vector<72xi8>, vector<72xi8>, vector<64xf32>
      vector.fragment.store<result> %product, %output_view[0, 0] shape [%m, %n] : vector<64xf32>, view<8x8xf32>
      channel.publish %output_write : write<tile<8x8xf32>>
      channel.release %lhs_read : read<tile<64xbf16>>
      channel.release %rhs_read : read<tile<64xbf16>>
    }
  }
}
